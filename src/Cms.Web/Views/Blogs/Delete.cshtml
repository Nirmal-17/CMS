@model Cms.Application.Models.BlogPostDto
@{
    ViewData["Title"] = "Delete post";
}

<h1>Delete post</h1>
<h4 class="text-danger">Are you sure you want to delete this article?</h4>
<hr />

<div class="card" style="max-width: 40rem;">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text text-muted mb-0">By @Model.AuthorName</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3 d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
